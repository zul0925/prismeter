{
  "name": "prismeter-tauri",
  "private": true,
  "version": "0.18.7",
  "license": "Apache-2.0",
  "scripts": {
    "tauri": "tauri",
    "check:frontend": "node --check frontend/app.js && node BuildFrontend.js && node VerifyVolcengineSignature.js",
    "check:backend": "cargo check --all-targets --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:frontend && npm run check:backend",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "prebuild": "npm run check:frontend",
    "build": "tauri build",
    "build:release": "powershell -ExecutionPolicy Bypass -File scripts/BuildSignedRelease.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
