{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prismeter",
  "version": "0.22.6",
  "identifier": "com.prismeter.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Prismeter",
    "shortDescription": "AI 用量中心",
    "longDescription": "集中查看不同 AI 平台账户、套餐、余额与远端用量。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IEU1OEE1NDlEQkFCM0REMTQKUldRVTNiTzZuVlNLNWRiOSt2NHg0bTg2SkpteHdVNXVCTXhyeU5hSGljUFlISk93NmFUaUE0MlgK",
      "endpoints": [
        "https://github.com/zul0925/prismeter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
